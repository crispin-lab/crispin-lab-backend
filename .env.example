POSTGRES_DB=DBNAME
POSTGRES_USER=USERNAME
POSTGRES_PASSWORD=PASSWORD

# 첫 ADMIN 부트스트랩 — 일치하는 이메일의 user 가 존재하면 자동 promote.
# 미설정 시 noop. .claude/rules/dev-infra.md 참조.
ADMIN_EMAIL=

# Pinpoint APM — 자세한 절차는 .claude/rules/dev-infra.md.
PINPOINT_VERSION=3.0.5
PINPOINT_COLLECTOR_HOST=localhost
PINPOINT_AGENT_PATH=./docker/pinpoint/agent/pinpoint-agent-3.0.5/pinpoint-bootstrap-3.0.5.jar
PINPOINT_AGENT_ID=crispin-lab-local
PINPOINT_APPLICATION_NAME=crispin-lab
# 호스트 8079 로 노출되므로 공유 네트워크에서는 반드시 별도 값으로.
PINPOINT_ADMIN_PASSWORD=
PINPOINT_MYSQL_USER=pinpoint
PINPOINT_MYSQL_PASSWORD=pinpoint
PINPOINT_MYSQL_ROOT_PASSWORD=pinpoint
