<?xml version="1.0"?>
<!--
  pinpoint-hbase 3.0.5 image default 의 distributed + 외부 ZK quorum 구성을 standalone 으로
  override. 동기와 트레이드오프는 dev-infra.md 의 "standalone HBase 의 트레이드오프" 참조.
  clientPortAddress=0.0.0.0 은 다른 컨테이너가 `pinpoint-hbase:2181` 로 도달 가능하게 하는 용도.
-->
<configuration>
    <property>
        <name>hbase.rootdir</name>
        <value>file:///home/pinpoint/hbase</value>
    </property>
    <property>
        <name>hbase.cluster.distributed</name>
        <value>false</value>
    </property>
    <property>
        <name>hbase.zookeeper.property.dataDir</name>
        <value>/home/pinpoint/hbase/zookeeper</value>
    </property>
    <property>
        <name>hbase.zookeeper.property.clientPort</name>
        <value>2181</value>
    </property>
    <property>
        <name>hbase.zookeeper.property.clientPortAddress</name>
        <value>0.0.0.0</value>
    </property>
    <property>
        <name>zookeeper.znode.parent</name>
        <value>/hbase</value>
    </property>
    <property>
        <name>hbase.master.port</name>
        <value>60000</value>
    </property>
    <property>
        <name>hbase.regionserver.port</name>
        <value>60020</value>
    </property>
</configuration>
